# ========================================================
# MediSmart AI — Environment Configuration
# ========================================================

# Django General Settings
DEBUG=True
SECRET_KEY=change-this-to-a-secure-random-string-in-production
ALLOWED_HOSTS=127.0.0.1,localhost

# ========================================================
# RESEND EMAIL SERVICE (Password Reset via OTP)
# Get your free key at: https://resend.com/api-keys
# ========================================================
RESEND_API_KEY=re_your_api_key_here
# If using a free test account without custom domain, use: onboarding@resend.dev
RESEND_FROM_EMAIL=onboarding@resend.dev

# ========================================================
# TIDB CLOUD DATABASE (Serverless MySQL Compatible)
# Get your free cluster at: https://tidbcloud.com/
#
# When USE_TIDB=False or TIDB_HOST is empty, local SQLite
# (db.sqlite3) will be used automatically.
# Set USE_TIDB=True once you fill in your TiDB details below.
# ========================================================
USE_TIDB=False
TIDB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
TIDB_PORT=4000
TIDB_USER=your_username.root
TIDB_PASSWORD=your_password
TIDB_DB_NAME=test
